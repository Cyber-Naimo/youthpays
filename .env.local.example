# Supabase — Project → Settings → API
# Copy this file to .env.local and fill in. Never commit .env.local (secrets).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the SECRET / service_role key (starts with sb_secret_... or a long service_role JWT),
# NOT the publishable/anon key. Server-only — do NOT prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVICE_ROLE_KEY
